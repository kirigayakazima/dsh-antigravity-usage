{
  "name": "dsh-antigravity-usage",
  "version": "0.2.0",
  "description": "反重力（Antigravity）额度 / 用量监控：实时额度走本地语言服务器 API，离线用量只读扫本地会话库（反重力没开也能看历史）",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "meta": {
    "title": "反重力额度",
    "description": "热读取反重力（Antigravity）本地语言服务器的实时额度、token 与缓存命中，并在本地累积历史趋势。"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirigayakazima/dsh-antigravity-usage.git"
  },
  "homepage": "https://github.com/kirigayakazima/dsh-antigravity-usage",
  "bugs": {
    "url": "https://github.com/kirigayakazima/dsh-antigravity-usage/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-modules": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-modules": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/collector.js && node --check lib/history.js && node --check lib/conversations.js && node --check lib/client.js",
    "test": "node scripts/test-history.mjs && node scripts/test-client.mjs && node scripts/test-render.mjs && node scripts/smoke.mjs --temp",
    "smoke": "node scripts/smoke.mjs --temp",
    "probe": "node scripts/probe.mjs",
    "conversations": "node scripts/test-conversations.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "antigravity",
    "quota",
    "usage",
    "tokens"
  ],
  "devDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
